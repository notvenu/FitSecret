# Supabase project (Settings > API). Without these the site runs on the demo catalogue and checkout is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used to confirm online payments.
SUPABASE_SERVICE_ROLE_KEY=
# Razorpay (optional). Leave blank for Cash-on-Delivery only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Store contact shown on the site
NEXT_PUBLIC_STORE_PHONE=919000000000
# Live courier tracking on the Track page (optional, server only). Set the order's courier to "Shiprocket" or "Delhivery" in the POS.
# Shiprocket: create an API user (Shiprocket → Settings → API → Configure) and use its email/password here.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Delhivery: API token from your Delhivery One account manager / developer portal. DELHIVERY_STAGING=1 uses the staging host.
DELHIVERY_API_TOKEN=
DELHIVERY_STAGING=
# Public site address (canonical links, sitemap, robots). On Vercel the production domain is used when this is blank.
NEXT_PUBLIC_SITE_URL=https://fitsecretsstore.com
# Optional store details shown once set
NEXT_PUBLIC_FSSAI_NO=
NEXT_PUBLIC_STORE_HOURS=
# Google Business Profile → "Ask for reviews" link. The Track page asks delivered customers for a review.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Store pickup at checkout: on unless set to off
NEXT_PUBLIC_PICKUP=on
# Same-day delivery for these pincode prefixes when ordered before this hour (IST). 0 turns it off.
NEXT_PUBLIC_SAME_DAY_CUTOFF=18
NEXT_PUBLIC_SAME_DAY_PINCODES=520
